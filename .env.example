# Copy this file to .env (same folder) and fill in your PostgreSQL connection.
# The database must already exist; the app creates its tables on first start.
DATABASE_URL=postgres://nec_app:change-me@localhost:5432/nec_dashboard

# Optional — defaults are used when these are not set.
# PORT=3000
# APP_USERNAME=admin
# APP_PASSWORD=change-me
# SESSION_SECRET=a-long-random-string
